# Copie para backend/.env e ajuste. A chave também pode ser salva pela tela Configurações.

# Chave do Google AI Studio (https://aistudio.google.com/apikey) — plano gratuito.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# O plano gratuito limita requisições por minuto: espera entre lotes de texto.
GEMINI_INTERVALO_SEGUNDOS=6
GEMINI_MAX_CHARS_POR_LOTE=12000

# Pasta do banco SQLite e dos arquivos enviados (padrão: backend/data)
# PATRIMONIO_DATA_DIR=
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
